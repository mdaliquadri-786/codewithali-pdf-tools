{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/why-us", "destination": "/why-us.html" }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/why-us.html", "destination": "/why-us", "permanent": true },
    {
      "source": "/tool.html",
      "has": [{ "type": "query", "key": "tool", "value": "(?<slug>.*)" }],
      "destination": "/tools/:slug",
      "permanent": false
    },
    { "source": "/tool.html", "destination": "/", "permanent": false }
  ]
}
